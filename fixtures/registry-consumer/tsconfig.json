{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "lucide-react": ["./types/lucide-react.tsx"],
      "react-hook-form": ["./types/react-hook-form.tsx"],
      "@hookform/resolvers/zod": ["./types/hookform-resolvers-zod.ts"]
    }
  },
  "include": [
    "app.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "types/**/*.ts",
    "types/**/*.tsx"
  ]
}
