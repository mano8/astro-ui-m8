{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../registry-consumer/*"],
      "lucide-react": ["./shims/lucide-react.tsx"],
      "react-hook-form": ["./shims/react-hook-form.tsx"],
      "@hookform/resolvers/zod": ["./shims/hookform-resolvers-zod.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "shims/**/*.ts", "shims/**/*.tsx"]
}
